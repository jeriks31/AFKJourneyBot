<Window x:Class="AFKJourneyBot.App.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tasks="clr-namespace:AFKJourneyBot.Core.Tasks;assembly=AFKJourneyBot.Core"
        mc:Ignorable="d"
        d:DesignWidth="480"
        d:DesignHeight="720"
        Title="AFK Journey Bot"
        Icon="avares://AFKJourneyBot.App/Assets/app.ico"
        RequestedThemeVariant="Dark"
        Width="480"
        Height="720"
        MinWidth="380"
        MinHeight="520">
  <Grid Margin="16" RowDefinitions="Auto,*,300" RowSpacing="12">
    <Border Grid.Row="0" Classes="panel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#F4F6F8"
                     Text="Active task" />
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#E8EAED"
                     Text="{Binding ActiveTaskName}" />
          <TextBlock FontSize="12"
                     Foreground="#98A2B3"
                     Text="{Binding ActiveTaskElapsedTime, StringFormat='Elapsed: {0}'}" />
        </StackPanel>

        <Button Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Stop"
                Command="{Binding StopCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="1">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Classes="section-title" Text="Tasks" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Tasks}"
                        VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid
                  Columns="{Binding Bounds.Width,
                  RelativeSource={RelativeSource AncestorType=ScrollViewer},
                  Converter={StaticResource TaskColumnCountConverter}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="task-card"
                        ToolTip.Tip="{Binding Description}"
                        Command="{Binding $parent[Window].DataContext.RunTaskCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Classes="task-title"
                             Text="{Binding Name}"
                             TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Grid.Row="0" Classes="section-title" Text="Logs" />

        <Border Grid.Row="1"
                Background="#0B0D12"
                BorderBrush="#252B34"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6">
          <ScrollViewer x:Name="LogScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Logs}"
                          HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="log-line"
                             Classes.debug="{Binding IsDebug}"
                             Classes.info="{Binding IsInformation}"
                             Classes.warning="{Binding IsWarning}"
                             Classes.error="{Binding IsError}"
                             Text="{Binding Message}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
