<Application x:Class="AFKJourneyBot.App.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:AFKJourneyBot.App.Converters"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <converters:TaskColumnCountConverter x:Key="TaskColumnCountConverter" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#111318" />
      <Setter Property="Foreground" Value="#E8EAED" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.task-card">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.task-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F6F8" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F6F8" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#181B22" />
      <Setter Property="BorderBrush" Value="#2D3440" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="SelectableTextBlock.log-line">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#B8C0CC" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

  </Application.Styles>
</Application>
